{
  "name": "web-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "西方奇幻戰術 SRPG — Web (Phaser) + 可選桌面 (Tauri)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build --mode app && node scripts/app-dist.mjs",
    "cap:android": "npm run build:app && cap sync android",
    "preview": "vite preview",
    "balance": "tsx scripts/balance-sim.ts",
    "optimize-assets": "node scripts/optimize-assets.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "td:sim": "tsx scripts/td-sim.ts",
    "td:levels": "tsx scripts/td-level-tool.ts",
    "td:optimize": "tsx scripts/td-optimize.ts",
    "test:td": "tsx --test tests/td/*.test.ts"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@fontsource/luckiest-guy": "^5.3.0",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@tauri-apps/cli": "^2.0.0",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.10"
  }
}
